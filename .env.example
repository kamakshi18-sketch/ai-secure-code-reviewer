# AI Secure Code Reviewer - Environment Configuration
# Copy this file to .env and fill in your values

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
POSTGRES_USER=ai_reviewer
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_DB=ai_code_reviewer
DATABASE_URL=postgresql+asyncpg://ai_reviewer:secure_password_change_me@localhost:5432/ai_code_reviewer

# Redis
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMADB_URL=http://localhost:8000

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# GitHub OAuth (for user authentication)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# GitHub App (for repository operations)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# LLM APIs
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_MODEL=gemini-1.5-flash

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_WORKER_CONCURRENCY=4

# Scanner Configuration
SCAN_TIMEOUT=1800
MAX_PATCH_RETRIES=3
MAX_FILE_SIZE_MB=10
SUPPORTED_LANGUAGES=python,javascript,typescript,java,go,ruby,php,csharp

SEMGREP_CONFIG=auto
BANDIT_CONFIG=
GITLEAKS_CONFIG=
TRIVY_SEVERITY=HIGH,CRITICAL

# RAG Configuration
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
ALLOWED_HOSTS=["*"]

# Monitoring (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# GitHub API
GITHUB_API_URL=https://api.github.com
GITHUB_RAW_URL=https://raw.githubusercontent.com

# File Paths
REPORT_OUTPUT_DIR=/tmp/reports
TEMP_DIR=/tmp/ai-reviewer